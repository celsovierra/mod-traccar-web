          <Button
            variant="contained"
            startIcon={<SendIcon />}
            onClick={() => handleSend('SMS')}
            disabled={sending}
            fullWidth
            sx={{
              py: 1.2,
              fontWeight: 'bold',
              fontSize: { xs: '12px', sm: '14px' },
              bgcolor: '#ffe0b2',
              color: '#e65100',
              '&:hover': { bgcolor: '#ffcc80' },
            }}
          >
            {sending ? 'Enviando...' : 'SMS'}
          </Button>
        </Box>

        <Box display="flex" justifyContent="space-between" alignItems="center" mb={1}>
          <Box display="flex" alignItems="center" gap={1}>
            <Typography variant="subtitle2" fontWeight="bold" color="#1976d2">
              RELATÃ“RIO
            </Typography>
            <Paper
              sx={{
                px: 1,
                py: 0.1,
                bgcolor: '#1976d2',
                color: '#fff',
                fontSize: '11px',
                borderRadius: '10px',
                fontWeight: 'bold',
              }}
            >
              {reports.length}
            </Paper>
          </Box>

          <Typography
            variant="caption"
            color="error"
            sx={{ cursor: 'pointer', fontWeight: 'bold' }}
            onClick={() => updateReports([])}
          >
            LIMPAR
          </Typography>
        </Box>

        <Typography
          variant="caption"
          display="block"
          color="text.secondary"
          sx={{ mb: 1 }}
        >
          Mensagens pendentes sÃ£o atualizadas automaticamente a cada 10 segundos.
        </Typography>

        <Box display="flex" flexDirection="column" gap={1.5}>
          {reports.map((report) => {
            const colors = getReportColors(report);

            return (
              <Paper
                key={report.localId}
                variant="outlined"
                onClick={() => handleCardClick(report)}
                sx={{
                  p: 2,
                  borderRadius: '12px',
                  borderColor: colors.border,
                  bgcolor: colors.background,
                }}
              >
                <Box
                  display="flex"
                  justifyContent="space-between"
                  alignItems="center"
                  mb={0.5}
                >
                  <Box display="flex" alignItems="center" gap={1}>
                    {isSuccess(report) ? (
                      <CheckCircle color="success" fontSize="small" />
                    ) : isPending(report) ? (
                      <SyncIcon color="warning" fontSize="small" />
                    ) : (
                      <ErrorIcon color="error" fontSize="small" />
                    )}

                    <Typography
                      variant="body2"
                      fontWeight="bold"
                      color={colors.text}
                    >
                      {report.status}
                    </Typography>

                    <Typography
                      variant="caption"
                      bgcolor="#e0e0e0"
                      px={1}
                      py={0.2}
                      borderRadius="4px"
                      fontWeight="bold"
                    >
                      {report.type}
                    </Typography>
                  </Box>

                  <Box display="flex" alignItems="center" gap={0.5}>
                    <Typography variant="caption" color="textSecondary">
                      {report.time}
                    </Typography>

                    {report.apiId && (
                      <IconButton
                        size="small"
                        onClick={() => refreshOneReport(report)}
                        title="Consultar status agora"
                      >
                        <SyncIcon fontSize="inherit" />
                      </IconButton>
                    )}
                  </Box>
                </Box>

                <Typography variant="body2" fontFamily="monospace" fontWeight="bold">
                  {report.text}
                </Typography>

                <Typography
                  variant="caption"
                  color="textSecondary"
                  display="block"
                  mt={0.5}
                >
                  ðŸš— {report.deviceName} ({report.phone})
                </Typography>

                {report.apiId && (
                  <Typography
                    variant="caption"
                    color="textSecondary"
                    display="block"
                    mt={0.5}
                  >
                    ID SMSMarket: {report.apiId}
                    {report.carrier ? ` â€¢ ${report.carrier}` : ''}
                  </Typography>
                )}

                {report.error && (
                  <Typography
                    variant="caption"
                    color="error.main"
                    display="block"
                    mt={0.5}
                  >
                    Erro: {report.error}
                  </Typography>
                )}
              </Paper>
            );
          })}
        </Box>
      </DialogContent>
    </Dialog>
  );
};

export default SmsMarketModal;








